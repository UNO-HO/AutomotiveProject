<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량(AAOS) 전용 앱. Pleos Connect Emulator에서 실행한다. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- AAOS 표준 Car API: 속도(런타임 요청)·기어 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Pleos NaviHelper: 경로 상태·TBT 조회, 내비 화면(휴게소 검색) 요청 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- Pleos TextToSpeech -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 기본 TTS 엔진 대체용 패키지 가시성 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 화면이 가려지지 않도록. 대신 주행 중 조작은 큰 버튼 두 개로 제한했다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
